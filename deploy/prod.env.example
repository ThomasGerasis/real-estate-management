APP_NAME="Real Estate"
APP_ENV=production
APP_KEY=base64:                                    # ← php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://yourdomain.com                     # ← your domain

APP_LOCALE=el
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db                                         # ← do not change (docker service name)
DB_PORT=3306
DB_DATABASE=real_estate
DB_USERNAME=real_estate
DB_PASSWORD=                                       # ← strong password (e.g. openssl rand -base64 32)

# ─── Session / Cache / Queue ──────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com                     # ← your domain with leading dot

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=real_estate

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis                                   # ← do not change (docker service name)
REDIS_PORT=6379
REDIS_PASSWORD=                                    # ← strong password (e.g. openssl rand -base64 32)
REDIS_USERNAME=default

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com                # ← your frontend domain

# ─── Caddy (SSL) ──────────────────────────────────────────────────────────────
CADDY_EMAIL=your@email.com                         # ← for Let's Encrypt notifications
APP_DOMAIN=yourdomain.com                          # ← your domain (no https://)

# ─── Optional: Contabo Object Storage (S3-compatible) ────────────────────────
# Uncomment when you set up object storage for property image uploads
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=                               # ← from Contabo object storage panel
# AWS_SECRET_ACCESS_KEY=                           # ← from Contabo object storage panel
# AWS_DEFAULT_REGION=eu2
# AWS_BUCKET=real-estate-storage
# AWS_ENDPOINT=https://eu2.contabostorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_URL=https://eu2.contabostorage.com/real-estate-storage
