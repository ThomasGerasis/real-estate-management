# Global Caddy options
{
    frankenphp
    email {$CADDY_EMAIL:admin@example.com}
    # Uncomment to test with staging CA first (avoids Let's Encrypt rate limits):
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ─── Main domain ─────────────────────────────────────────────────────────────
{$APP_DOMAIN:yourdomain.com} {

    root * /app/public

    # Classic (non-worker) PHP handling. Worker mode requires the app to be
    # bootstrapped via Laravel Octane's FrankenPHP driver (not installed here);
    # using `worker` against the stock index.php makes FrankenPHP fail to boot.
    php_server

    encode zstd br gzip

    header {
        X-Content-Type-Options     nosniff
        X-Frame-Options            SAMEORIGIN
        X-XSS-Protection           "1; mode=block"
        Referrer-Policy            strict-origin-when-cross-origin
        Strict-Transport-Security  "max-age=31536000; includeSubDomains; preload"
        Permissions-Policy         "camera=(), microphone=(), geolocation=()"
        -Server
    }

    @immutable {
        path /build/* /storage/*
    }
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    @static {
        path /css/* /js/* /img/* /favicon.ico /robots.txt
    }
    header @static Cache-Control "public, max-age=86400"
}
